    local function getCategory(name)
        local lower = name:lower()
        for _, b in ipairs(ESP_BLACKLIST) do
            if lower:find(b, 1, true) then return nil end
        end
        for _, cat in ipairs(ESP_CATEGORIES) do
            for _, w in ipairs(cat.words) do
                if cat.name == "TV" then
                    if lower:find("tv", 1, true) or lower:find("television", 1, true) then return cat end
                elseif cat.name == "Kunci" then
                    if lower:find("keyitem") or lower:find("kunci") or lower:find("key_") or lower == "key" then return cat end
                elseif cat.name == "Piring" then
                    if lower:find("piring") or lower:find("plate") or lower:find("dish") then return cat end
                elseif cat.name == "Korek" then
                    if lower:find("korek") or lower:find("lighter") or lower:find("fire") then return cat end
                elseif cat.name == "Tali" then
                    if lower:find("tali") or lower:find("rope") then return cat end
                else
                    if lower:find(w, 1, true) then return cat end
                end
            end
        end
        return nil
    end

    local function isMonster(name)
        local lower = name:lower()
        for _, b in ipairs(ESP_BLACKLIST) do
            if lower:find(b, 1, true) then return false end
        end
        for _, w in ipairs(ESP_MONSTER_WORDS) do
            if lower:find(w, 1, true) then return true end
        end
        return false
    end

