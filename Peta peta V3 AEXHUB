    local function processObject(obj)
        if not obj:IsA("BasePart") then return end
        if obj:FindFirstChild("AEX_Tag") or obj:FindFirstChild("AEX_MonsterTag") then return end
        if isEquippedByChar(obj) then return end
        
        if espState.Monster and isMonster(obj.Name) then
            createMonsterESP(obj)
        elseif not isMonster(obj.Name) then
            local cat = getCategory(obj.Name)
            if cat and espState[cat.name] then
                createESP(obj, cat)
            end
        end
    end

