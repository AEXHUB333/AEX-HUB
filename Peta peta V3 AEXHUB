    local function unlock()
        local input = keyBox.Text:gsub("%s+", "")
        if input == CONFIG.KEY then
            keyStatus.TextColor3 = CONFIG.THEME.SUCCESS
            keyStatus.Text = "Access granted. Loading..."
            task.wait(0.4)
            keyGui:Destroy()
            buildMainUI()
        else
            keyStatus.TextColor3 = CONFIG.THEME.DANGER
            keyStatus.Text = "Invalid key."
            keyBox.Text = ""
            tween(keyFrame, {Position = UDim2.new(0.5, -155, 0.5, -140)}, 0.05)
            tween(keyFrame, {Position = UDim2.new(0.5, -150, 0.5, -140)}, 0.08)
        end
    end

