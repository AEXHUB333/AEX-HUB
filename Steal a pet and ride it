local function drag(f, d)
    local s, p, o
    d.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then s=true; p=i.Position; o=f.Position end end)
    UIS.InputChanged:Connect(function(i) if s and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then local dl=i.Position-p; f.Position=UDim2.new(o.X.Scale,o.X.Offset+dl.X,o.Y.Scale,o.Y.Offset+dl.Y) end end)
    d.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then s=false end end)
end

-- ===== LOGIC (RAGDOLL ANTI-DROP) =====
local safeZone = nil
local isBypassing = false
local statusTxt = nil

local function doBypass()
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not safeZone or not hrp or not hum or isBypassing then return end
    
    isBypassing = true
    local heldTool = char:FindFirstChildOfClass("Tool")
    local ncConn = nil
    local lockCFrame = nil

    -- Noclip
    local function setNoclip(on)
        if ncConn then ncConn:Disconnect() end
        if on then
            ncConn = RS.Stepped:Connect(function()
                for _,v in ipairs(char:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end)
        else
            for _,v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = true end
            end
        end
    end

    -- RAGDOLL ANTI-DROP & ANTI-KNOCKBACK
    local heartbeatConn = RS.Heartbeat:Connect(function()
        if not isBypassing then return end
        
        -- 1. Hapus BodyMover (Efek mental)
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyGyro") or v:IsA("BodyPosition") then
                v:Destroy()
            end
        end

        -- 2. Paksa berdiri
        hum.PlatformStand = false
        if hum:GetState() == Enum.HumanoidStateType.FallingDown or hum:GetState() == Enum.HumanoidStateType.Ragdoll then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        
        -- 3. Kunci CFrame (Biar gak mental)
        if lockCFrame then
            hrp.CFrame = lockCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        
        -- 4. ANTI-DROP KANDANG (Cek terus-terusan kalau lepas)
        if heldTool then
            if heldTool.Parent ~= char then
                heldTool.Parent = char
                pcall(function() hum:EquipTool(heldTool) end)
            end
            
            -- Weld paksa ke badan
            if heldTool:FindFirstChild("Handle") then
                heldTool.Handle.CanCollide = false
                local weld = heldTool.Handle:FindFirstChild("AEX_GlueWeld")
                if not weld then
                    weld = Instance.new("Weld") -- Pakai Weld klasik, lebih kuat dari WeldConstraint saat ragdoll
                    weld.Name = "AEX_GlueWeld"
                    weld.Part0 = hrp
                    weld.Part1 = heldTool.Handle
                    weld.C0 = CFrame.new(0, 0, 0)
                    weld.C1 = heldTool.Handle.CFrame:ToObjectSpace(hrp.CFrame)
                    weld.Parent = heldTool.Handle
                end
            end
        end
    end)

    -- Tangkap event kalau game maksa ngelepas
    local dropConn = char.ChildRemoved:Connect(function(child)
        if child == heldTool and isBypassing then
            task.wait(0.01)
            heldTool.Parent = char
            pcall(function() hum:EquipTool(heldTool) end)
        end
    end)

    task.spawn(function()
        local targetPos = safeZone.Position
        local startBypass = tick()
        
        -- 1. FASE MICRO-TP (Berhenti di 30 Stud)
        setNoclip(true)
        while isBypassing and hrp.Parent do
            if (tick() - startBypass > 30) or hrp.Position.Y < -50 then
                hrp.CFrame = safeZone
                break
            end
            
            local distToSafe = (targetPos - hrp.Position).Magnitude
            if distToSafe <= 30 then break end
            
            if statusTxt then statusTxt.Text = "MOVING..." end
            local moveDir = (targetPos - hrp.Position).Unit
            
            if moveDir == moveDir then
                hrp.CFrame = CFrame.new(hrp.Position + (moveDir * 16.5)) * (hrp.CFrame - hrp.CFrame.Position)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
            task.wait(0.1)
        end
        
        if not isBypassing then return end
        
        -- 2. FASE NUNGGU HIT (3 Detik di 30 Stud)
        setNoclip(false)
        lockCFrame = hrp.CFrame -- Kunci posisi di sini
        
        if statusTxt then 
            statusTxt.Text = "WAIT HIT (3s)!" 
            statusTxt.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
        end
        
        task.wait(3) -- Nunggu 3 detik
        
        -- 3. FASE JALAN MANUAL
        if statusTxt then 
            statusTxt.Text = "WALK TO SAFE ZONE!" 
            statusTxt.BackgroundColor3 = Color3.fromRGB(40, 180, 90)
        end
        
        isBypassing = false
        heartbeatConn:Disconnect()
        dropConn:Disconnect()
        
        -- Hapus Weld pas selesai
        if heldTool and heldTool:FindFirstChild("Handle") then
            local w = heldTool.Handle:FindFirstChild("AEX_GlueWeld")
            if w then w:Destroy() end
        end
        
        task.wait(3)
        if statusTxt then
            statusTxt.Text = "BYPASS"
            statusTxt.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
        end
    end)
end

