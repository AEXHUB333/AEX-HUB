local espEnabled = false
local espObjects = {}
local function clearESP(target)
    local data = espObjects[target]
    if data then
        for _, o in pairs(data) do if o and o.Parent then o:Destroy() end end
        espObjects[target] = nil
    end
end
local function addESP(target, color, label)
    if espObjects[target] then return end
    local hl = Instance.new("Highlight", target)
    hl.Name = "AdminESP_Highlight"; hl.FillColor = color; hl.OutlineColor = Color3.new(1,1,1)
    hl.FillTransparency = 0.5; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Adornee = target
    local anchor = target:IsA("BasePart") and target or target:FindFirstChildWhichIsA("BasePart", true)
    local bb
    if anchor then
        bb = Instance.new("BillboardGui", target)
        bb.Name = "AdminESP_Label"; bb.Size = UDim2.fromOffset(140, 24); bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true; bb.Adornee = anchor
        local tl = Instance.new("TextLabel", bb)
        tl.Size = UDim2.fromScale(1,1); tl.BackgroundTransparency = 1; tl.Text = label; tl.TextColor3 = color
        tl.TextStrokeTransparency = 0; tl.Font = Enum.Font.GothamBold; tl.TextScaled = true
    end
    espObjects[target] = { hl, bb }
    target.AncestryChanged:Connect(function(_, parent) if not parent then clearESP(target) end end)
end
local function scanESP()
    for _, d in ipairs(workspace:GetDescendants()) do
        if (d:IsA("Model") or d:IsA("BasePart")) and not espObjects[d] then
            if not isPlayerDescendant(d) then
                local n = lower(d.Name)
                if not containsAny(n, CONFIG.ESP_Exclude) and not containsAny(n, CONFIG.MonsterExclude) then
                    if d:IsA("Model") and containsAny(n, CONFIG.MonsterNames) then
                        addESP(d, CONFIG.MonsterColor, "[NPC] " .. d.Name)
                    elseif isKeyTarget(d) then
                        if isPasscodeObj(d) then
                            addESP(d, CONFIG.PasscodeColor, "[PASSCODE] " .. d.Name)
                        else
                            addESP(d, CONFIG.ItemColor, "[KEY] " .. d.Name)
                        end
                    end
                end
            end
        end
    end
end
local espConn
local function setESP(state)
    espEnabled = state
    if state then
        scanESP()
        local acc = 0
        espConn = RS.Heartbeat:Connect(function(dt)
            acc += dt
            if acc >= 2 then acc = 0; scanESP() end
        end)
    else
        if espConn then espConn:Disconnect(); espConn = nil end
        for target in pairs(espObjects) do clearESP(target) end
    end
end

