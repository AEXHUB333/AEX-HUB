local function lower(s) return string.lower(s or "") end
local function containsAny(str, list)
    for _, n in ipairs(list) do if string.find(str, n, 1, true) then return true end end
    return false
end
local function getRoot() return plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") end
local function getPivotPosition(inst)
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local p = inst:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position or nil
end

