-- ============================================================
local collectedKeys = {}
local SAFE_ZONE = nil

local function isPlayerDescendant(d)
    for _, p in ipairs(P:GetPlayers()) do
        if p.Character and (d == p.Character or d:IsDescendantOf(p.Character)) then return true end
    end
    return false
end

local function isPasscodeObj(d)
    local n = lower(d.Name)
    return containsAny(n, CONFIG.PasscodeNames)
end

local function isKeyOnlyObj(d)
    local n = lower(d.Name)
    if containsAny(n, CONFIG.PasscodeNames) then return false end
    return containsAny(n, CONFIG.KeyNames)
end

local function isKeyTarget(d)
    if not (d:IsA("Model") or d:IsA("BasePart") or d:IsA("Tool")) then return false end
    if isPlayerDescendant(d) then return false end
    if d:IsDescendantOf(plr.Character) then return false end
    if plr.Backpack and d:IsDescendantOf(plr.Backpack) then return false end
    
    local n = lower(d.Name)
    if string.find(n, "keyhole", 1, true) or string.find(n, "lock", 1, true) or string.find(n, "gembok", 1, true) or string.find(n, "door", 1, true) then return false end
    if containsAny(n, CONFIG.ESP_Exclude) or containsAny(n, CONFIG.MonsterExclude) then return false end
    
    if containsAny(n, CONFIG.KeyNames) then return true end
    if containsAny(n, CONFIG.PasscodeNames) then return true end
    return false
end

-- ============================================================
-- MACRO TP 15 STUD
-- ============================================================
local function teleportAndLock(targetPos, offset)
    if not targetPos then return false end
    local hrp = getRoot()
    if not hrp then return false end
    local finalPos = targetPos + (offset or Vector3.zero)
    local step, delay, maxSteps = MACRO_TP_STEP, MACRO_TP_DELAY, 150
    while maxSteps > 0 and hrp.Parent do
        local dist = (finalPos - hrp.Position).Magnitude
        if dist <= step then hrp.CFrame = CFrame.new(finalPos); break end
        local dir = (finalPos - hrp.Position).Unit
        hrp.CFrame = CFrame.new(hrp.Position + dir * step) * (hrp.CFrame - hrp.CFrame.Position)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        maxSteps -= 1
        task.wait(delay)
    end
    local lockStart = tick()
    while tick() - lockStart < 0.2 do
        hrp.CFrame = CFrame.new(finalPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.05)
    end
    return true
end

