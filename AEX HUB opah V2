-- FORCE COLLECT
-- ============================================================
local function forceFireAll(inst, hrp)
    if not inst or not inst.Parent or not hrp then return end
    local prompts, clicks, parts = {}, {}, {}
    if inst:IsA("ProximityPrompt") then table.insert(prompts, inst) end
    if inst:IsA("ClickDetector") then table.insert(clicks, inst) end
    if inst:IsA("BasePart") then table.insert(parts, inst) end
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
        if d:IsA("ClickDetector") then table.insert(clicks, d) end
        if d:IsA("BasePart") then table.insert(parts, d) end
    end
    for _, pr in ipairs(prompts) do
        pcall(function() pr.RequiresLineOfSight = false end)
        pcall(function() pr.MaxActivationDistance = 1e6 end)
        pcall(function() pr.HoldDuration = 0 end)
        if typeof(fireproximityprompt) == "function" then pcall(fireproximityprompt, pr) end
        pcall(function() pr:InputHoldBegin(); pr:InputHoldEnd() end)
    end
    for _, cd in ipairs(clicks) do
        pcall(function() cd.MaxActivationDistance = 1e6 end)
        if typeof(fireclickdetector) == "function" then pcall(fireclickdetector, cd) end
    end
    for _, pt in ipairs(parts) do
        if typeof(firetouchinterest) == "function" then
            pcall(firetouchinterest, hrp, pt, 0)
            task.wait(0.03)
            pcall(firetouchinterest, hrp, pt, 1)
        end
    end
end

local function bypassCollect(inst)
    if not inst or not inst.Parent then return false end
    local hrp = getRoot()
    local pos = getPivotPosition(inst)
    if not hrp or not pos then return false end
    
    teleportAndLock(pos + Vector3.new(0, 0.5, 0))
    task.wait(0.1)
    forceFireAll(inst, hrp)
    task.wait(0.1)
    forceFireAll(inst, hrp)
    return true
end

