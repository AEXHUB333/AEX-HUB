end)

local function toggleSpd(on)
    local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if on then origSpd=hum.WalkSpeed; hum.WalkSpeed=100 else hum.WalkSpeed=origSpd end
end

RS.Stepped:Connect(function()
    local c=plr.Character
    if c and st.nc then for _,v in ipairs(c:GetDescendants()) do if v:IsA("BasePart") then if ncP[v]==nil then ncP[v]=v.CanCollide end v.CanCollide=false end end end
end)

local function tpItem()
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local near, dist = nil, math.huge
    for _,v in ipairs(WS:GetDescendants()) do
        if (v:IsA("Model") or v:IsA("BasePart")) and isO(v.Name) then
            local p=getPos(v); if p then local d=(p-hrp.Position).Magnitude; if d<dist then near,dist=p,d end end
        end
    end
    if near then hrp.CFrame = CFrame.new(near+Vector3.new(0,4,0)) end
end

