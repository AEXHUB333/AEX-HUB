local st = {espE=false, espO=false, spd=false, nc=false, path=false}
local objs={}; local origSpd=0; local ncP={}
local pf = Instance.new("Folder", WS); pf.Name="_PathViz"

local function getPos(i) if i:IsA("BasePart") then return i.Position elseif i:IsA("Model") then return i:GetPivot().Position end return nil end
local function isE(n) n=n:lower(); return n:find("opah") or n:find("nenek") or n:find("monster") or n:find("ghost") or n:find("paman") or n:find("npc") end
local function isO(n) n=n:lower(); return n:find("key") or n:find("kunci") or n:find("hint") or n:find("note") or n:find("catatan") or n:find("item") end

local function espLoop()
    for i,d in pairs(objs) do if d.hl then d.hl:Destroy() end if d.bb then d.bb:Destroy() end objs[i]=nil end
    if not (st.espE or st.espO) then return end
    for _,v in ipairs(WS:GetDescendants()) do
        if v:IsA("Model") or v:IsA("BasePart") then
            local n=v.Name; local c
            if st.espE and isE(n) then c=Color3.fromRGB(255,60,60)
            elseif st.espO and isO(n) then c=Color3.fromRGB(80,255,120) end
            if c then
                local hl=Instance.new("Highlight",v); hl.FillColor=c; hl.OutlineColor=c; hl.FillTransparency=.5; hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                local part = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart",true)
                if part then
                    local bb=Instance.new("BillboardGui",part); bb.Size=UDim2.fromOffset(100,24); bb.AlwaysOnTop=true; bb.StudsOffset=Vector3.new(0,3,0)
                    local t=Instance.new("TextLabel",bb); t.Size=UDim2.fromScale(1,1); t.BackgroundTransparency=1; t.TextColor3=c; t.TextStrokeTransparency=.3; t.Font=Enum.Font.GothamBold; t.TextSize=10; t.Text=n
                    objs[v]={hl=hl, bb=bb, t=t, p=part}
                end
            end
        end
    end
end

