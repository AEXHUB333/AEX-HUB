local ESP = { granny = false, items = false, keys = false, players = false }
local GRANNY_KEYWORDS = {"granny","grandpa","slendrina","monster","enemy","npc"}
local ITEM_KEYWORDS   = {"item","tool","pickup","collect","weapon"}
local KEY_KEYWORDS    = {"key","padlock","lockpick","screwdriver","pliers","hammer","wrench"}

local function hasKeyword(name, list)
    local n = name:lower()
    for _, k in ipairs(list) do if n:find(k, 1, true) then return true end end
    return false
end

local function makeHighlight(model, color)
    if not model or not model:IsA("Model") then return end
    local old = model:FindFirstChild("AEX_HL")
    if old then old:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = "AEX_HL"; hl.FillColor = color; hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.45; hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Adornee = model; hl.Parent = model
end

local function makeBillboard(part, text, color)
    if not part then return end
    local old = part:FindFirstChild("AEX_BB")
    if old then old:Destroy() end
    local bb = Instance.new("BillboardGui")
    bb.Name = "AEX_BB"; bb.Size = UDim2.new(0, 80, 0, 20)
    bb.StudsOffset = Vector3.new(0, 2, 0); bb.AlwaysOnTop = true; bb.Parent = part
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.new(1, 0, 1, 0); tl.BackgroundTransparency = 1; tl.Text = text
    tl.TextColor3 = color; tl.TextStrokeTransparency = 0; tl.TextSize = 10
    tl.Font = Enum.Font.GothamBold; tl.Parent = bb
end

local function clearESP()
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d.Name == "AEX_HL" or d.Name == "AEX_BB" then pcall(function() d:Destroy() end) end
    end
end

local function refreshESP()
    if ESP.granny then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("Model") and hasKeyword(v.Name, GRANNY_KEYWORDS) then makeHighlight(v, Color3.fromRGB(255, 30, 30)) end
        end
    end
    if ESP.items then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if (v:IsA("Model") or v:IsA("BasePart")) and hasKeyword(v.Name, ITEM_KEYWORDS) then
                local a = v:IsA("BasePart") and v or v.PrimaryPart
                if a then makeBillboard(a, v.Name, Color3.fromRGB(255, 220, 60)) end
            end
        end
    end
    if ESP.keys then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if (v:IsA("Model") or v:IsA("BasePart")) and hasKeyword(v.Name, KEY_KEYWORDS) then
                local a = v:IsA("BasePart") and v or v.PrimaryPart
                if a then makeBillboard(a, v.Name, Color3.fromRGB(120, 255, 120)) end
            end
        end
    end
    if ESP.players then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then makeHighlight(p.Character, Color3.fromRGB(80, 160, 255)) end
        end
    end
end

