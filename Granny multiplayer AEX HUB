local function buildUILogo(parent, size)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(size, size)
    frame.BackgroundTransparency = 1
    frame.Parent = parent

    local function part(pos, sz, rot)
        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = pos
        f.Size = sz
        f.Rotation = rot
        f.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        f.BorderSizePixel = 0
        f.Parent = frame
        Instance.new("UICorner", f).CornerRadius = UDim.new(0, 1)
    end

    part(UDim2.new(0.5, 0, 0.2, 0), UDim2.new(0.08, 0, 0.35, 0), 25)   
    part(UDim2.new(0.5, 0, 0.2, 0), UDim2.new(0.08, 0, 0.35, 0), -25)  
    part(UDim2.new(0.5, 0, 0.25, 0), UDim2.new(0.22, 0, 0.05, 0), 0)   
    part(UDim2.new(0.25, 0, 0.75, 0), UDim2.new(0.06, 0, 0.35, 0), 0)  
    part(UDim2.new(0.28, 0, 0.6, 0), UDim2.new(0.25, 0, 0.06, 0), 10)  
    part(UDim2.new(0.27, 0, 0.75, 0), UDim2.new(0.2, 0, 0.06, 0), 10)  
    part(UDim2.new(0.28, 0, 0.9, 0), UDim2.new(0.25, 0, 0.06, 0), 10)  
    part(UDim2.new(0.75, 0, 0.75, 0), UDim2.new(0.08, 0, 0.35, 0), 45) 
