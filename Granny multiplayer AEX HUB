local function addToggle(name, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 30); b.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    b.Text = "  "..name.."  [OFF]"; b.TextColor3 = Color3.fromRGB(180, 180, 200)
    b.TextSize = 11; b.Font = Enum.Font.Gotham; b.TextXAlignment = Enum.TextXAlignment.Left
    b.BorderSizePixel = 0; b.Parent = feats
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    local s = false
    b.MouseButton1Click:Connect(function()
        s = not s; b.Text = "  "..name.."  ["..(s and "ON" or "OFF").."]"
        b.TextColor3 = s and Color3.fromRGB(160, 100, 255) or Color3.fromRGB(180, 180, 200); cb(s)
    end)
end

local function addSlider(name, mn, mx, dft, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 42); f.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    f.BorderSizePixel = 0; f.Parent = feats
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 4)
    local lb = Instance.new("TextLabel")
    lb.Size = UDim2.new(1, -16, 0, 16); lb.Position = UDim2.new(0, 8, 0, 4)
    lb.BackgroundTransparency = 1; lb.Text = name..": "..dft
    lb.TextColor3 = Color3.fromRGB(180, 180, 200); lb.TextSize = 11
    lb.Font = Enum.Font.Gotham; lb.TextXAlignment = Enum.TextXAlignment.Left; lb.Parent = f
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -16, 0, 6); bar.Position = UDim2.new(0, 8, 0, 26)
    bar.BackgroundColor3 = Color3.fromRGB(15, 15, 20); bar.BorderSizePixel = 0; bar.Parent = f
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 3)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((dft-mn)/(mx-mn), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(120, 60, 200); fill.BorderSizePixel = 0; fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)
    local drag = false
    bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((i.Position.X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X, 0, 1)
            local v = math.floor(mn + (mx-mn)*rel + 0.5)
            fill.Size = UDim2.new(rel, 0, 1, 0); lb.Text = name..": "..v; cb(v)
        end
    end)
end

